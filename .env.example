# Required: PageSpeed Insights API key
PSI_API_KEY=
# Optional: full path of the .xlsx workbook file (e.g. a OneDrive/SharePoint-synced folder). Default: reports/lighthouse-history.xlsx
AUDIT_WORKBOOK_PATH=
# Optional: FOLDER for raw Lighthouse HTML reports (e.g. a OneDrive folder; each run adds a timestamped subfolder). Default: raw-results
RAW_RESULTS_PATH=
